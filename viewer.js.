import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js';
import { OrbitControls } from 'https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/controls/OrbitControls.js';

const container = document.getElementById('pc3d');

if (container) {
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0x101525);

    const camera = new THREE.PerspectiveCamera(
        45,
        container.clientWidth / container.clientHeight,
        0.1,
        100
    );

    camera.position.set(5, 3, 6);

    const renderer = new THREE.WebGLRenderer({ antialias: true });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;

    container.appendChild(renderer.domElement);

    const controls = new OrbitControls(camera, renderer.domElement);
    controls.enableDamping = true;
    controls.target.set(0, 1.4, 0);

    scene.add(new THREE.AmbientLight(0xffffff, 1.5));

    const light = new THREE.DirectionalLight(0xffffff, 3);
    light.position.set(4, 7, 5);
    scene.add(light);

    const rgbLight = new THREE.PointLight(0x713cff, 15, 8);
    rgbLight.position.set(0, 2, 1);
    scene.add(rgbLight);

    const pc = new THREE.Group();
    scene.add(pc);

    const dark = new THREE.MeshStandardMaterial({
        color: 0x171c2b,
        metalness: 0.7,
        roughness: 0.3
    });

    const glass = new THREE.MeshStandardMaterial({
        color: 0x334466,
        transparent: true,
        opacity: 0.22,
        metalness: 0.4,
        roughness: 0.1
    });

    const purple = new THREE.MeshStandardMaterial({
        color: 0x823cff,
        emissive: 0x5215ff,
        emissiveIntensity: 1.5
    });

    function box(w, h, d, x, y, z, material) {
        const mesh = new THREE.Mesh(
            new THREE.BoxGeometry(w, h, d),
            material
        );

        mesh.position.set(x, y, z);
        mesh.castShadow = true;
        pc.add(mesh);

        return mesh;
    }

    // Корпус
    box(2.5, 3.8, 2, 0, 1.9, 0, dark);

    // Стеклянная боковая панель
    box(2.42, 3.65, 0.04, 0, 1.9, 1.03, glass);

    // Материнская плата
    box(1.65, 2.7, 0.08, 0, 2, 0.87, dark);

    // Видеокарта
    box(1.8, 0.35, 0.65, 0, 1.4, 0.55, dark);

    // Подсветка видеокарты
    box(1.5, 0.05, 0.03, 0, 1.4, 0.9, purple);

    // Оперативная память
    for (let i = 0; i < 2; i++) {
        box(0.12, 0.9, 0.15, -0.45 + i * 0.3, 2.5, 0.8, purple);
    }

    // Кулер процессора
    box(0.65, 0.55, 0.45, 0, 2.7, 0.55, dark);

    // Вентиляторы
    function fan(x, y, z, radius = 0.38) {
        const geometry = new THREE.CylinderGeometry(
            radius,
            radius,
            0.12,
            32
        );

        const mesh = new THREE.Mesh(geometry, purple);
        mesh.rotation.x = Math.PI / 2;
        mesh.position.set(x, y, z);
        pc.add(mesh);
    }

    fan(0.7, 0.8, 0.85);
    fan(0.7, 1.8, 0.85);
    fan(0.7, 2.8, 0.85);

    // Пол
    const floor = new THREE.Mesh(
        new THREE.PlaneGeometry(200, 200),
        new THREE.MeshStandardMaterial({ color: 0x101525 })
    );

    floor.rotation.x = -Math.PI / 2;
    floor.position.y = -0.05;
    scene.add(floor);

    // Изменение подсветки
    function updateViewer() {
        const selects = document.querySelectorAll('#parts select');

        if (selects.length > 1) {
            const gpuName = selects[1].selectedOptions[0]?.textContent || '';

            if (gpuName.includes('RTX')) {
                purple.color.set(0x35aaff);
                purple.emissive.set(0x176bff);
            } else if (gpuName.includes('RX')) {
                purple.color.set(0xff4b8b);
                purple.emissive.set(0xff174f);
            } else {
                purple.color.set(0x823cff);
                purple.emissive.set(0x5215ff);
            }
        }
    }

    document.getElementById('parts')?.addEventListener('change', updateViewer);

    updateViewer();

    function animate() {
        requestAnimationFrame(animate);
        controls.update();
        renderer.render(scene, camera);
    }

    animate();

    window.addEventListener('resize', () => {
        camera.aspect = container.clientWidth / container.clientHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(container.clientWidth, container.clientHeight);
    });
}
