const scene = new THREE.Scene();
scene.background = new THREE.Color(0x101525);

const camera = new THREE.PerspectiveCamera(
    45,
    container.clientWidth / container.clientHeight,
    0.1,
    100
);

camera.position.set(5, 3, 7);

const renderer = new THREE.WebGLRenderer({
    antialias: true
});

renderer.setSize(container.clientWidth, container.clientHeight);
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
renderer.shadowMap.enabled = true;

container.appendChild(renderer.domElement);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.target.set(0, 1.7, 0);
controls.minDistance = 4;
controls.maxDistance = 12;

// ОСВЕЩЕНИЕ

scene.add(new THREE.AmbientLight(0xffffff, 2));

const mainLight = new THREE.DirectionalLight(0xffffff, 3);
mainLight.position.set(5, 8, 6);
scene.add(mainLight);

const rgbLight = new THREE.PointLight(0x823cff, 25, 10);
rgbLight.position.set(0, 2, 1);
scene.add(rgbLight);

// МАТЕРИАЛЫ

const black = new THREE.MeshStandardMaterial({
    color: 0x171b29,
    metalness: 0.65,
    roughness: 0.35
});

const metal = new THREE.MeshStandardMaterial({
    color: 0x41495c,
    metalness: 0.85,
    roughness: 0.25
});

const boardMaterial = new THREE.MeshStandardMaterial({
    color: 0x173b35,
    metalness: 0.3,
    roughness: 0.7
});

const rgb = new THREE.MeshStandardMaterial({
    color: 0x823cff,
    emissive: 0x5215ff,
    emissiveIntensity: 2
});

const glass = new THREE.MeshStandardMaterial({
    color: 0x6688aa,
    transparent: true,
    opacity: 0.12,
    metalness: 0.4,
    roughness: 0.1
});

const pc = new THREE.Group();
scene.add(pc);

// СОЗДАНИЕ ДЕТАЛЕЙ

function box(w, h, d, x, y, z, material) {
    const mesh = new THREE.Mesh(
        new THREE.BoxGeometry(w, h, d),
        material
    );

    mesh.position.set(x, y, z);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    pc.add(mesh);

    return mesh;
}

// КОРПУС

// Нижняя и верхняя части
box(2.8, 0.12, 2.3, 0, 0.1, 0, metal);
box(2.8, 0.12, 2.3, 0, 3.8, 0, metal);

// Боковые стенки
box(0.12, 3.8, 2.3, -1.34, 1.95, 0, black);
box(0.12, 3.8, 2.3, 1.34, 1.95, 0, black);

// Задняя стенка
box(2.8, 3.8, 0.12, 0, 1.95, -1.1, black);

