// ВИДЕОКАРТА

box(1.9, 0.4, 0.65, 0.15, 1.45, 0.45, black);

// Вентиляторы видеокарты
function gpuFan(x) {
    const fan = new THREE.Mesh(
        new THREE.CylinderGeometry(0.16, 0.16, 0.08, 32),
        rgb
    );

    fan.rotation.x = Math.PI / 2;
    fan.position.set(x, 1.45, 0.8);
    pc.add(fan);
}

gpuFan(-0.4);
gpuFan(0.15);
gpuFan(0.7);

// КУЛЕР ПРОЦЕССОРА

box(0.7, 0.65, 0.5, -0.35, 3.1, 0.65, metal);

// КОРПУСНЫЕ ВЕНТИЛЯТОРЫ

function fan(x, y, z) {
    const ring = new THREE.Mesh(
        new THREE.TorusGeometry(0.38, 0.045, 12, 40),
        rgb
    );

    ring.position.set(x, y, z);
    pc.add(ring);

    const center = new THREE.Mesh(
        new THREE.CylinderGeometry(0.1, 0.1, 0.12, 24),
        metal
    );

    center.rotation.x = Math.PI / 2;
    center.position.set(x, y, z);
    pc.add(center);
}

fan(-0.85, 0.8, 1.0);
fan(-0.85, 1.9, 1.0);
fan(-0.85, 3.0, 1.0);

// ПОЛ

const floor = new THREE.Mesh(
    new THREE.PlaneGeometry(200, 200),
    new THREE.MeshStandardMaterial({
        color: 0x101525
    })
);

floor.rotation.x = -Math.PI / 2;
floor.position.y = 0;
scene.add(floor);

// RGB В ЗАВИСИМОСТИ ОТ ВИДЕОКАРТЫ

function updateViewer() {
    const selects = document.querySelectorAll('#parts select');

    if (selects.length > 1) {
        const gpuName =
            selects[1].selectedOptions[0]?.textContent || '';

        if (gpuName.includes('RTX')) {
            rgb.color.set(0x35aaff);
            rgb.emissive.set(0x176bff);
            rgbLight.color.set(0x35aaff);
        } else if (gpuName.includes('RX')) {
            rgb.color.set(0xff4b8b);
            rgb.emissive.set(0xff174f);
            rgbLight.color.set(0xff4b8b);
        } else {
            rgb.color.set(0x823cff);
            rgb.emissive.set(0x5215ff);
            rgbLight.color.set(0x823cff);
        }
    }
}

document.getElementById('parts')?.addEventListener(
    'change',
    updateViewer
);

updateViewer();

// АНИМАЦИЯ

function animate() {
    requestAnimationFrame(animate);

    controls.update();
    renderer.render(scene, camera);
}

animate();

// АДАПТАЦИЯ ПОД ЭКРАН

window.addEventListener('resize', () => {
    const width = container.clientWidth;
    const height = container.clientHeight;

    if (!width || !height) return;

    camera.aspect = width / height;
    camera.updateProjectionMatrix();

    renderer.setSize(width, height);
});
}
